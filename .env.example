# ==============================================================================
# Belal Ashraf Portfolio - Environment Configuration
# ==============================================================================

# Storage Mode: 'local' (default for dev) or 'github' (for production on Vercel)
KEYSTATIC_STORAGE=local

# GitHub Repository Information (used when KEYSTATIC_STORAGE=github)
NEXT_PUBLIC_KEYSTATIC_GITHUB_OWNER=J-Ahmad19
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=belal_portfolio

# GitHub OAuth App Credentials (for production admin authentication via GitHub)
# Create a GitHub OAuth App or Keystatic GitHub App:
# Authorization callback URL: https://your-domain.vercel.app/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=generate_a_random_32_character_secret_here

# Admin Password protection for /admin and /keystatic (default: belal2026)
ADMIN_PASSWORD=belal2026
