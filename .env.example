# ==============================================================================
# Belal Ashraf Portfolio - Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================================================

# Storage Mode: 'local' (default for dev) or 'github' (for production on Vercel)
KEYSTATIC_STORAGE=local

# GitHub Repository Information (used when KEYSTATIC_STORAGE=github)
NEXT_PUBLIC_KEYSTATIC_GITHUB_OWNER=your_github_username
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=your_repository_name

# GitHub OAuth App Credentials (for production admin authentication via GitHub)
# Create a GitHub OAuth App or Keystatic GitHub App:
# Authorization callback URL: https://<your-domain>/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Optional: Set an admin password for an extra layer of HTTP Basic Auth on /admin
ADMIN_PASSWORD=
